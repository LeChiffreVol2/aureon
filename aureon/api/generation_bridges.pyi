from collections.abc import Callable, Generator, Iterable, Mapping
from dataclasses import dataclass
from typing import Any, Literal
from .contracts import ExecutionProfile, RecipeValues
from .memory_input import GenerationInput

@dataclass(frozen=True)
class GenerationRecipe:
    token_steps: int = ...
    diffusion_steps: int = ...
    temperature: float = ...
    top_p: float = ...
    top_k: int = ...
    seed: int = ...
    def native(self) -> RecipeValues: ...
    @classmethod
    def from_terratorch(cls, settings: Mapping[str, Any], *, seed: int,
                       model_id: str, terratorch_version: str) -> GenerationRecipe: ...

class TorchGeoAdapter:
    def __init__(self, *, bands: list[str] | tuple[str, ...], units: str,
                 valid_mask: Callable[[Mapping[str, Any]], Any], normalization: str = ...,
                 grid: Callable[[Mapping[str, Any]], Mapping[str, Any] | None] | None = ...,
                 source_id: Callable[[Mapping[str, Any]], str | None] | None = ...) -> None: ...
    def __call__(self, sample: Mapping[str, Any]) -> GenerationInput: ...

class TorchGeoBatchAdapter:
    def __init__(self, *, bands: list[str] | tuple[str, ...], units: str,
                 valid_mask: Callable[[Mapping[str, Any], int], Any], normalization: str = ...,
                 image: Callable[[Mapping[str, Any]], Any] | None = ...,
                 grid: Callable[[Mapping[str, Any], int], Mapping[str, Any] | None] | None = ...,
                 source_id: Callable[[Mapping[str, Any], int], str | None] | None = ...,
                 max_batch_size: int = ..., max_batch_image_bytes: int = ...) -> None: ...
    def iter_inputs(self, batches: Iterable[Mapping[str, Any]], *, max_samples: int | None = ...,
                    stop: Callable[[], bool] | None = ...) -> Generator[GenerationInput, None, None]: ...
    def iter_jobs(self, batches: Iterable[Mapping[str, Any]], *, recipe: GenerationRecipe | None = ...,
                  seed_policy: Literal["same", "input_identity"] = ...,
                  execution_profile: ExecutionProfile | None = ...,
                  job_id: Callable[[GenerationInput, int], str | None] | None = ...,
                  max_samples: int | None = ..., stop: Callable[[], bool] | None = ...) -> Generator[GenerationJob, None, None]: ...

@dataclass(frozen=True)
class GenerationJob:
    input_data: GenerationInput
    recipe: GenerationRecipe = ...
    execution_profile: ExecutionProfile | None = ...
    job_id: str | None = ...
    attempt_id: str = ...
    def options(self) -> dict[str, Any]: ...

def generation_capabilities(*, model_id: str = ...) -> dict[str, Any]: ...
def generation_compatibility(input_data: GenerationInput, *, recipe: GenerationRecipe | None = ...,
                             execution_profile: ExecutionProfile = ..., model_id: str = ...) -> dict[str, Any]: ...
