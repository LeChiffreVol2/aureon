from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path
from threading import Event
from types import TracebackType
from typing import Any, Self, Literal, TypeAlias, Protocol
from .generation_engine import GenerationEngine
from .memory_input import GenerationInput

InvalidTilePolicy: TypeAlias = Literal['reject', 'skip_invalid_tiles']
TILE_SIZE: int

@dataclass(frozen=True)
class GenerationWindow:
    row: int
    col: int
    height: int = ...
    width: int = ...
    @property
    def tile_id(self) -> str: ...

def generation_windows(height: int, width: int, *, stride: int = ...) -> Iterator[GenerationWindow]: ...
def generation_tile_seed(seed: int, window: GenerationWindow) -> int: ...

class GenerationRasterSource(Protocol):
    width: int
    height: int
    grid: dict[str, Any]
    @property
    def identity(self) -> dict[str, Any]: ...
    @property
    def is_open(self) -> bool: ...
    def read(self, window: GenerationWindow) -> GenerationInput: ...
    def read_if_valid(self, window: GenerationWindow, *, invalid_policy: InvalidTilePolicy = ...) -> GenerationInput | None: ...
    def inspect_validity(self, *, cancel_event: Event | None = ...) -> dict[str, Any]: ...
    def verify_unchanged(self) -> None: ...

class PreparedGenerationRaster:
    width: int
    height: int
    grid: dict[str, Any]
    identity: dict[str, Any]
    @property
    def is_open(self) -> bool: ...
    def __init__(self, image_path: str | Path, mask_path: str | Path, *,
                 bands: list[str] | tuple[str, ...], units: str, max_decode_bytes: int = ...) -> None: ...
    def __enter__(self) -> Self: ...
    def read(self, window: GenerationWindow) -> GenerationInput: ...
    def read_if_valid(self, window: GenerationWindow, *, invalid_policy: InvalidTilePolicy = ...) -> GenerationInput | None: ...
    def inspect_validity(self, *, cancel_event: Event | None = ...) -> dict[str, Any]: ...
    def verify_unchanged(self) -> None: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> None: ...

def generate_raster_scene(engine: GenerationEngine, source: GenerationRasterSource, output: str | Path,
                          *, seed: int = ..., stride: int = ..., max_buffer_bytes: int = ...,
                          max_output_bytes: int = ..., min_free_bytes: int = ...,
                          max_in_flight: int = ..., execute_model: bool = ...,
                          cancel_event: Event | None = ..., invalid_policy: InvalidTilePolicy = ...) -> dict[str, Any]: ...
