from collections.abc import Iterator
from types import TracebackType
from typing import Literal, Self
from .contracts import GenerationResult, HandleState

class GenerationHandle:
    @property
    def state(self) -> HandleState: ...
    def done(self) -> bool: ...
    def running(self) -> bool: ...
    def cancel(self) -> bool: ...
    def discard(self) -> None: ...
    def result(self, timeout: float | None = ...) -> GenerationResult: ...

class GenerationStream(Iterator[GenerationResult]):
    def __iter__(self) -> Self: ...
    def __next__(self) -> GenerationResult: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> Literal[False]: ...
