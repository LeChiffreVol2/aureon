from collections.abc import Callable
from pathlib import Path
from types import TracebackType
from typing import Any, Literal, Self
from .v1 import SceneResult

class SessionBusy(RuntimeError): ...
class SessionClosed(RuntimeError): ...
class SessionFailed(RuntimeError): ...

class EngineSession:
    def __init__(self, bundle: str | Path, work: str | Path, *, model_id: str = ...,
                 profile_id: str, environment: str = ..., qualification: str | Path | None = ...,
                 execute_model: bool = ...) -> None: ...
    def run(self, prepared_input: str | Path, *, job_id: str | None = ...,
            attempt_id: str | None = ..., is_current_attempt: Callable[[], bool] | None = ...) -> SceneResult: ...
    def metadata(self) -> dict[str, Any]: ...
    def close(self) -> dict[str, Any]: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> Literal[False]: ...
