from pathlib import Path
from types import TracebackType
from typing import Any, Literal, Self
from ..api.contracts import ExecutionProfile, GenerationResult, RecipeValues
from ..api.memory_input import GenerationInput

class SessionBusy(RuntimeError): ...
class SessionClosed(RuntimeError): ...
class SessionFailed(RuntimeError): ...

class TerraMindSession:
    def __init__(self, config: str | Path, work: str | Path, *, execute_model: bool = ...,
                 reuse: Literal["auto", "off"] = ..., decoder_context: Any = ...,
                 denoiser: Literal["native", "graph"] = ...,
                 execution_profile: ExecutionProfile | None = ..., model_id: str | None = ...) -> None: ...
    def metadata(self) -> dict[str, Any]: ...
    def generate(self, input_data: GenerationInput, *, job_id: str | None = ...,
                 attempt_id: str = ..., recipe: RecipeValues | None = ...,
                 execution_profile: ExecutionProfile | None = ...,
                 reuse: Literal["auto", "off"] | None = ...,
                 denoiser: Literal["native", "graph"] | None = ...) -> GenerationResult: ...
    def run(self, input_manifest: str | Path | GenerationInput | None = ..., *, job_id: str,
            attempt_id: str, recipe: RecipeValues | None = ..., reuse: Literal["auto", "off"] | None = ...,
            decoder_context: Any = ..., capture_logits: bool = ...,
            denoiser: Literal["native", "graph"] | None = ...,
            execution_profile: ExecutionProfile | None = ...) -> dict[str, Any]: ...
    def close(self) -> dict[str, Any]: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> Literal[False]: ...
